<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.0"/>
  <template class="PreferencesWindow" parent="AdwPreferencesWindow">
    <property name="title" translatable="yes">Preferences</property>
    <property name="default-width">600</property>
    <property name="default-height">400</property>
    <property name="destroy-with-parent">True</property>

    <child>
      <object class="AdwPreferencesPage">
        <property name="title" translatable="yes">General</property>
        <property name="icon-name">applications-system-symbolic</property>

        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Behavior</property>
            <child>
              <object class="AdwActionRow">
                <property name="title" translatable="yes">Auto-jump to History</property>
                <property name="subtitle" translatable="yes">Switch to History tab after adding a record</property>
                <child>
                  <object class="GtkSwitch" id="jump_switch">
                    <property name="valign">center</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>

        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Data Management</property>
            <property name="description" translatable="yes">Manage your tracker's database.</property>
            <child>
              <object class="AdwActionRow">
                <property name="title" translatable="yes">Clear History</property>
                <property name="subtitle" translatable="yes">Delete all intake records permanently</property>
                <child type="suffix">
                  <object class="GtkButton" id="clear_records_btn">
                    <property name="label" translatable="yes">Delete All</property>
                    <property name="valign">center</property>
                    <signal name="clicked" handler="on_clear_records_clicked"/>
                    <style>
                      <class name="destructive-action"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>

      </object>
    </child>
  </template>
</interface>
