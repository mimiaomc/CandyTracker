<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <template class="ConcentrationPlot" parent="GtkBox">
    <property name="orientation">vertical</property>
    <property name="vexpand">True</property>
    <property name="hexpand">True</property>
    <child>
      <object class="GtkDrawingArea" id="drawing_area">
        <property name="vexpand">True</property>
        <property name="hexpand">True</property>
      </object>
    </child>
    <child>
      <object class="GtkBox" id="pd_box">
        <property name="orientation">vertical</property>
        <property name="spacing">8</property>
        <property name="margin-start">16</property>
        <property name="margin-end">16</property>
        <property name="margin-top">16</property>
        <property name="margin-bottom">16</property>
        <child>
          <object class="GtkLabel" id="pd_title">
            <property name="xalign">0</property>
            <style><class name="heading"/></style>
          </object>
        </child>
        <child>
          <object class="GtkProgressBar" id="pd_progress">
            <property name="hexpand">True</property>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="orientation">horizontal</property>
            <child>
              <object class="GtkLabel" id="pd_current">
                <property name="hexpand">True</property>
                <property name="xalign">0</property>
                <style><class name="dim-label"/></style>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="pd_target">
                <property name="xalign">1</property>
                <style><class name="dim-label"/></style>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
